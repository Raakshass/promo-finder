# Pick the model with one variable: provider/model
# Free, open-weights, no daily cap (recommended): NVIDIA's API catalog, key from build.nvidia.com (no card)
#   nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b   (the model behind the official results; ~40 requests/min)
#   mistral/<model>               (Mistral's free Experiment tier, about 1B tokens a month)
#   gemini/gemini-2.5-flash       (free tier: ai.google.dev)
#   groq/llama-3.3-70b-versatile  (free tier: console.groq.com)
#   anthropic/<model>             (Anthropic API)
#   openai/gpt-4.1-mini           (OpenAI API)
#   openrouter/<model>            (OpenRouter)
#   ollama/<model>                (local, http://localhost:11434)
#   aimlapi/<model>               (AI/ML API, api.aimlapi.com)
#   custom/<model>                (ANY OpenAI-compatible endpoint: set PROMO_BASE_URL and PROMO_API_KEY below)
#   none                          (no key: heuristic-only mode)
# Model names change: run `uv run promo-finder models --provider gemini` and pick a current flash-class model.
# Free and proven on this pack: openrouter/nvidia/nemotron-3.5-super-vl:free with `--batch 5 --reasoning-off`
# (OpenRouter free models allow ~50 calls/day per account; keys OPENROUTER_API_KEY2/3 are rotated in automatically).
PROMO_MODEL=nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional: a different model for the cold-viewer judge (a different family reduces self-preference)
PROMO_JUDGE_MODEL=nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b

NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AIMLAPI_API_KEY=

# Any OpenAI-compatible endpoint (an internal gateway, LiteLLM, vLLM, Together, Fireworks, Azure /openai/v1, ...)
PROMO_BASE_URL=
PROMO_API_KEY=

# Deployed app only (Streamlit secrets): a private outputs.zip link, and an optional access code for viewers
# OUTPUTS_URL=https://drive.google.com/file/d/<id>/view
# APP_PASSWORD=
